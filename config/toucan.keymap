#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.dtsi>
#include <zmk-helpers/helper.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q  &kp W  &kp E  &kp R  &kp T      &kp Y  &kp U  &kp I      &kp O    &kp P
                &kp A  &kp S  &kp D  &kp F  &kp G      &kp H  &kp J  &kp K      &kp L    &kp SEMI
                &kp Z  &kp X  &kp C  &kp V  &kp B      &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH
                       &kp LCTRL &mo 1  &kp SPACE      &kp ENTER &mo 2 &mkp LCLK
            >;
        };

        // Scroll / Mouse Control Layer
        scroll_layer {
            bindings = <
                &trans &trans &trans &trans &trans     &trans &msc SCRL_UP   &trans &trans &trans
                &trans &trans &trans &trans &trans     &trans &msc SCRL_DOWN &trans &trans &trans
                &trans &trans &trans &trans &trans     &trans &mkp MCLK      &trans &trans &trans
                       &trans &trans &trans            &trans &trans         &mkp RCLK
            >;
        };
    };

    trackpad_scroll_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&glidepoint_right>;
        layers = <1>; // Activates when layer 1 (scroll_layer) is active
        
        evt-type = <INPUT_EV_REL>;
        x-code = <INPUT_REL_HWHEEL>;
        y-code = <INPUT_REL_WHEEL>;
        
        scale-multiplier = <1>;
        scale-divisor = <2>;
        y-invert;
    };
};
